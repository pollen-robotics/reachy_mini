mmand`` runs the job in a separate thread with its own event loop, but\nthe ``new_log_evt`` waiters live in the daemon loop. ``asyncio.Event.set()`` is\nnot thread-safe, so without hopping back onto the daemon loop the terminal DONE\nnotification is lost and ``ws_poll_info`` hangs forever (the desktop app's\n&quot;finalizing&quot; step never completes and the connection eventually drops).\n``from_threadpool`` mimics sync routes (``/update/start``), which call\n``run_command`` from FastAPI's threadpool, with no running loop.\n</code></pre>\n","environment":"default","setup":[{"id":"b95b689af9aa2f86c3b91833bfc4ffeb","type":"before","name":"event_loop_policy","status":"passed","steps":[],"duration":0},{"id":"dd2190be4c9dbc8cf9887998dbcf2d6b","type":"before","name":"tmp_path_factory","status":"passed","steps":[],"duration":1},{"id":"ec1ce98ce958acb134a3793cfcc81902","type":"before","name":"_isolated_hf_credentials","status":"passed","steps":[],"duration":1},{"id":"c72c722efc36eb2a7e27fd8901c52a99","type":"before","name":"monkeypatch","status":"passed","steps":[],"duration":0},{"id":"29cd9d8133adb6cf707ecd63ed5ff08d","type":"before","name":"_no_telemetry","status":"passed","steps":[],"duration":0},{"id":"148403377fb5adc1b91dd201346c6849","type":"before","name":"_function_scoped_runner","status":"passed","steps":[],"duration":0}],"teardown":[{"id":"ac9e7834a1e6c7fe562e26e5f4a89874","type":"after","name":"_function_scoped_runner::0","status":"passed","steps":[],"duration":1},{"id":"3873d8b58e1f78278060e49928de6e46","type":"after","name":"monkeypatch::0","status":"passed","steps":[],"duration":0}],"history":[{"id":"94bae7975619fbb3b23429ff12afede3","name":"test_ws_poll_info_receives_terminal_status_from_worker_thread[True]","fullName":"tests.unit_tests.test_bg_job_register#test_ws_poll_info_receives_terminal_status_from_worker_thread","environment":"default","status":"passed","retries":[],"start":1795597529811,"stop":1795597529915,"duration":104,"labels":[{"name":"tag","val